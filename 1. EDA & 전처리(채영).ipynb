    "Q1 = negative_sales_df['판매수량'].quantile(0.25)\n",
    "Q3 = negative_sales_df['판매수량'].quantile(0.75)\n",
    "IQR = Q3 - Q1\n",
    "\n",
    "# 3 * IQR 기준으로 이상치 판별\n",
    "lower_bound = Q1 - 1.5 * IQR\n",
