    "# 이상치 개수 확인\n",
    "outliers_count = (negative_sales_df['판매수량'] < lower_bound).sum()\n",
    "\n",
    "# 결과 출력\n",
    "print(f\"이상치 기점: {lower_bound}, 3 IQR 이상인 이상치 개수: {outliers_count}\")"
